# ── Anthropic (Claude) ─────────────────────────────────────────────────────
# Clé API pour l'optimisation du prompt → https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Higgsfield.ai ──────────────────────────────────────────────────────────
# Option A : Email + mot de passe (si votre compte utilise email/password)
HIGGSFIELD_EMAIL=votre@email.com
HIGGSFIELD_PASSWORD=votre_mot_de_passe

# Option B : Cookies exportés depuis votre navigateur (recommandé si Google/SSO)
# Voir README.md pour les instructions d'extraction
# Format JSON :  [{"name":"...","value":"...","domain":"higgsfield.ai","path":"/"}]
# ou format texte : "name1=val1; name2=val2"
HIGGSFIELD_COOKIES=

# ── Serveur ────────────────────────────────────────────────────────────────
PORT=5001
FLASK_DEBUG=false
