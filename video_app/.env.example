# Clé API Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Clé API Higgsfield — https://cloud.higgsfield.ai
# Format : "api-key:api-secret"  ou clé unique selon votre plan
HIGGSFIELD_API_KEY=hf-...

# Port de l'application (optionnel, défaut 5001)
PORT=5001

# Debug Flask (true/false)
FLASK_DEBUG=false
